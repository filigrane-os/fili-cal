# xbps package of fili-cal (Agenda), read by distro/build-repo.sh of Filigrane. Qt Quick comes with Quickshell already; qt6-svg
# draws its icon, qt6-wayland is the platform plugin. curl fetches the subscriptions and talks CalDAV, secret-tool keeps the
# account passwords in the keyring, notify-send shows the alerts, gio puts deleted calendars in the trash.
DESC="Agenda, the calendar and the reminders of Filigrane (Qt Quick, Rust, iCalendar files)"
DEPENDS="glibc>=2.39_1 libgcc>=0 qt6-declarative>=0 qt6-svg>=0 qt6-wayland>=0 curl>=0 libsecret>=0 libnotify>=0 glib>=0 xdg-utils>=0 wl-clipboard>=0"
SHLIBS="libc.so.6 libgcc_s.so.1 libstdc++.so.6 libQt6Core.so.6 libQt6Gui.so.6 libQt6Qml.so.6"
PKG_LICENSE="GPL-3.0-or-later"
# Same program under another name: `agenda` in a terminal does what `fili-cal` does
ALIASES="agenda"
