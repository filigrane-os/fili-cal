{
  "v": 1,
  "app_id": "fili-cal",
  "name": "Agenda",
  "program": "fili-cal",
  "ctl": "fili-cal ctl --pid %pid",
  "commands": [
    {
      "verb": "action",
      "args": "NAME [ARG]",
      "summary": "Run a command of the window (the same names as its menu, plus a few for the bar panel)",
      "reads": false
    },
    {
      "verb": "state",
      "summary": "JSON of the state of the window",
      "reads": true
    },
    {
      "verb": "actions",
      "summary": "JSON list of the action names",
      "reads": true
    }
  ],
  "actions": [
    {
      "name": "about",
      "label": "About Agenda"
    },
    {
      "name": "view-day",
      "label": "Day",
      "keys": "Ctrl+1"
    },
    {
      "name": "view-week",
      "label": "Week",
      "keys": "Ctrl+2"
    },
    {
      "name": "view-month",
      "label": "Month",
      "keys": "Ctrl+3"
    },
    {
      "name": "view-year",
      "label": "Year",
      "keys": "Ctrl+4"
    },
    {
      "name": "view-list",
      "label": "List",
      "keys": "Ctrl+5"
    },
    {
      "name": "today",
      "label": "Today",
      "keys": "Ctrl+T"
    },
    {
      "name": "previous",
      "label": "Previous",
      "keys": "Left"
    },
    {
      "name": "next",
      "label": "Next",
      "keys": "Right"
    },
    {
      "name": "new-event",
      "label": "New Event…",
      "keys": "Ctrl+N"
    },
    {
      "name": "undo",
      "label": "Undo",
      "keys": "Ctrl+Z"
    },
    {
      "name": "redo",
      "label": "Redo",
      "keys": "Ctrl+Shift+Z"
    },
    {
      "name": "refresh-calendars",
      "label": "Refresh Subscriptions",
      "keys": "Ctrl+R"
    },
    {
      "name": "join",
      "label": "Join Meeting",
      "keys": "Ctrl+J"
    },
    {
      "name": "next-event",
      "label": "Select Next Event",
      "keys": "Tab"
    },
    {
      "name": "previous-event",
      "label": "Select Previous Event",
      "keys": "Shift+Tab"
    },
    {
      "name": "move-earlier",
      "label": "Move Earlier",
      "keys": "Alt+Up"
    },
    {
      "name": "move-later",
      "label": "Move Later",
      "keys": "Alt+Down"
    },
    {
      "name": "move-day-before",
      "label": "Move to the Day Before",
      "keys": "Alt+Left"
    },
    {
      "name": "move-day-after",
      "label": "Move to the Day After",
      "keys": "Alt+Right"
    },
    {
      "name": "shorten",
      "label": "Shorten",
      "keys": "Alt+Shift+Up"
    },
    {
      "name": "lengthen",
      "label": "Lengthen",
      "keys": "Alt+Shift+Down"
    },
    {
      "name": "copy-event",
      "label": "Copy",
      "keys": "Ctrl+C"
    },
    {
      "name": "paste-event",
      "label": "Paste",
      "keys": "Ctrl+V"
    },
    {
      "name": "duplicate-event",
      "label": "Duplicate",
      "keys": "Ctrl+D"
    },
    {
      "name": "toggle-done",
      "label": "Mark as Done",
      "keys": "Ctrl+Shift+D"
    },
    {
      "name": "delete-event",
      "label": "Delete",
      "keys": "Delete"
    },
    {
      "name": "search",
      "label": "Search…",
      "keys": "Ctrl+F",
      "args": "[TEXT]"
    },
    {
      "name": "select",
      "args": "ID"
    },
    {
      "name": "goto",
      "args": "DATE"
    },
    {
      "name": "import",
      "label": "Import…",
      "keys": "Ctrl+I"
    },
    {
      "name": "import-file",
      "args": "PATH_OR_LINK"
    },
    {
      "name": "new-from",
      "args": "JSON"
    },
    {
      "name": "export",
      "label": "Export…",
      "keys": "Ctrl+E"
    },
    {
      "name": "add-account",
      "label": "Add Account…",
      "keys": "Ctrl+Alt+A"
    },
    {
      "name": "new-calendar",
      "label": "New Calendar…",
      "keys": "Ctrl+Alt+N"
    },
    {
      "name": "quick-add",
      "label": "Quick Add…",
      "keys": "Ctrl+Shift+N"
    },
    {
      "name": "settings",
      "label": "Settings…"
    },
    {
      "name": "toggle-header",
      "label": "Show Header"
    },
    {
      "name": "toggle-footer",
      "label": "Show Status Bar"
    },
    {
      "name": "attention"
    },
    {
      "name": "attention-clear"
    },
    {
      "name": "debug",
      "label": "Debug Logs",
      "keys": "Ctrl+Shift+L"
    },
    {
      "name": "toggle-window-buttons",
      "label": "Show Window Buttons"
    },
    {
      "name": "window-actions",
      "label": "Window Actions…",
      "keys": "Ctrl+Shift+W"
    },
    {
      "name": "close",
      "label": "Close",
      "keys": "Ctrl+W"
    }
  ]
}
