{
 "name": "Agenda",
 "app": [
  {
   "label": "About Agenda",
   "exec": "fili-cal ctl --pid %pid action about"
  },
  {
   "label": "Settings\u2026",
   "exec": "fili-cal ctl --pid %pid action settings"
  }
 ],
 "window": [
  {
   "label": "Window Actions\u2026",
   "exec": "fili-cal ctl --pid %pid action window-actions",
   "keys": "Ctrl+Shift+W"
  },
  {
   "label": "Show Window Buttons",
   "exec": "fili-cal ctl --pid %pid action toggle-window-buttons"
  },
  {
   "label": "Show Header",
   "exec": "fili-cal ctl --pid %pid action toggle-header"
  },
  {
   "label": "Show Status Bar",
   "exec": "fili-cal ctl --pid %pid action toggle-footer"
  }
 ],
 "menus": [
  {
   "label": "File",
   "children": [
    {
     "label": "New Event\u2026",
     "exec": "fili-cal ctl --pid %pid action new-event",
     "keys": "Ctrl+N"
    },
    {
     "label": "Quick Add\u2026",
     "exec": "fili-cal ctl --pid %pid action quick-add",
     "keys": "Ctrl+Shift+N"
    },
    {
     "label": "New Calendar\u2026",
     "exec": "fili-cal ctl --pid %pid action new-calendar",
     "keys": "Ctrl+Alt+N"
    },
    {
     "label": "Add Account\u2026",
     "exec": "fili-cal ctl --pid %pid action add-account",
     "keys": "Ctrl+Alt+A"
    },
    {
     "label": "Refresh Subscriptions",
     "exec": "fili-cal ctl --pid %pid action refresh-calendars",
     "keys": "Ctrl+R"
    },
    {
     "sep": true
    },
    {
     "label": "Import\u2026",
     "exec": "fili-cal ctl --pid %pid action import",
     "keys": "Ctrl+I"
    },
    {
     "label": "Export\u2026",
     "exec": "fili-cal ctl --pid %pid action export",
     "keys": "Ctrl+E"
    },
    {
     "sep": true
    },
    {
     "label": "Close",
     "exec": "fili-cal ctl --pid %pid action close",
     "keys": "Ctrl+W"
    }
   ]
  },
  {
   "label": "Edit",
   "children": [
    {
     "label": "Undo",
     "exec": "fili-cal ctl --pid %pid action undo",
     "keys": "Ctrl+Z"
    },
    {
     "label": "Redo",
     "exec": "fili-cal ctl --pid %pid action redo",
     "keys": "Ctrl+Shift+Z"
    },
    {
     "sep": true
    },
    {
     "label": "Copy",
     "exec": "fili-cal ctl --pid %pid action copy-event",
     "keys": "Ctrl+C"
    },
    {
     "label": "Paste",
     "exec": "fili-cal ctl --pid %pid action paste-event",
     "keys": "Ctrl+V"
    },
    {
     "label": "Duplicate",
     "exec": "fili-cal ctl --pid %pid action duplicate-event",
     "keys": "Ctrl+D"
    },
    {
     "label": "Mark as Done",
     "exec": "fili-cal ctl --pid %pid action toggle-done",
     "keys": "Ctrl+Shift+D"
    },
    {
     "label": "Delete",
     "exec": "fili-cal ctl --pid %pid action delete-event",
     "keys": "Delete"
    },
    {
     "sep": true
    },
    {
     "label": "Select Next Event",
     "exec": "fili-cal ctl --pid %pid action next-event",
     "keys": "Tab"
    },
    {
     "label": "Select Previous Event",
     "exec": "fili-cal ctl --pid %pid action previous-event",
     "keys": "Shift+Tab"
    },
    {
     "label": "Move Earlier",
     "exec": "fili-cal ctl --pid %pid action move-earlier",
     "keys": "Alt+Up"
    },
    {
     "label": "Move Later",
     "exec": "fili-cal ctl --pid %pid action move-later",
     "keys": "Alt+Down"
    },
    {
     "label": "Move to the Day Before",
     "exec": "fili-cal ctl --pid %pid action move-day-before",
     "keys": "Alt+Left"
    },
    {
     "label": "Move to the Day After",
     "exec": "fili-cal ctl --pid %pid action move-day-after",
     "keys": "Alt+Right"
    },
    {
     "label": "Shorten",
     "exec": "fili-cal ctl --pid %pid action shorten",
     "keys": "Alt+Shift+Up"
    },
    {
     "label": "Lengthen",
     "exec": "fili-cal ctl --pid %pid action lengthen",
     "keys": "Alt+Shift+Down"
    },
    {
     "sep": true
    },
    {
     "label": "Search\u2026",
     "exec": "fili-cal ctl --pid %pid action search",
     "keys": "Ctrl+F"
    }
   ]
  },
  {
   "label": "View",
   "children": [
    {
     "label": "Day",
     "exec": "fili-cal ctl --pid %pid action view-day",
     "keys": "Ctrl+1"
    },
    {
     "label": "Week",
     "exec": "fili-cal ctl --pid %pid action view-week",
     "keys": "Ctrl+2"
    },
    {
     "label": "Month",
     "exec": "fili-cal ctl --pid %pid action view-month",
     "keys": "Ctrl+3"
    },
    {
     "label": "Year",
     "exec": "fili-cal ctl --pid %pid action view-year",
     "keys": "Ctrl+4"
    },
    {
     "label": "List",
     "exec": "fili-cal ctl --pid %pid action view-list",
     "keys": "Ctrl+5"
    },
    {
     "sep": true
    },
    {
     "label": "Today",
     "exec": "fili-cal ctl --pid %pid action today",
     "keys": "Ctrl+T"
    },
    {
     "label": "Previous",
     "exec": "fili-cal ctl --pid %pid action previous",
     "keys": "Left"
    },
    {
     "label": "Next",
     "exec": "fili-cal ctl --pid %pid action next",
     "keys": "Right"
    },
    {
     "sep": true
    },
    {
     "label": "Debug Logs",
     "exec": "fili-cal ctl --pid %pid action debug",
     "keys": "Ctrl+Shift+L"
    }
   ]
  }
 ]
}